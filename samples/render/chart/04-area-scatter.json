{
  "blocks": [
    { "type": "heading", "text": "Area, Dual Axes & Log-Scale Scatter (charts v2)", "level": 1 },
    { "type": "paragraph", "text": "The area chart binds one series to a secondary right axis (series.yAxis: 'right' + block.axis2); the scatter chart positions points by numeric xValues on a linear x-axis with a logarithmic value axis (log requires strictly positive values)." },
    {
      "type": "chart",
      "chartType": "area",
      "title": "Traffic vs error rate",
      "categories": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
      "legend": "bottom",
      "axis": { "grid": true },
      "axis2": { "yMin": 0, "yMax": 5, "ticks": 5 },
      "series": [
        { "label": "Requests (k)", "values": [120, 132, 128, 141, 155, 96, 88] },
        { "label": "Errors (%)", "values": [0.8, 1.1, 0.9, 2.4, 1.2, 0.7, 0.6], "yAxis": "right" }
      ]
    },
    { "type": "spacer", "height": 18 },
    {
      "type": "chart",
      "chartType": "scatter",
      "title": "Response time vs payload size (log y-axis)",
      "legend": "bottom",
      "xAxis": { "type": "linear", "min": 0, "max": 1000, "grid": true },
      "axis": { "scale": "log" },
      "markers": true,
      "series": [
        { "label": "p50 (ms)", "values": [12, 18, 35, 80, 210], "xValues": [10, 50, 150, 400, 900] },
        { "label": "p99 (ms)", "values": [45, 90, 180, 520, 1400], "xValues": [10, 50, 150, 400, 900] }
      ]
    }
  ]
}
